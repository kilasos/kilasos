# /etc/kilasos/env — environment file for nasd.service (EnvironmentFile=-/etc/kilasos/env)
#
# Marked config|noreplace in nfpm.yaml — dpkg will preserve local edits across upgrades.
# All values are commented out; uncomment and set as needed.

# Legacy bearer token. Prefer per-user API keys in /var/lib/kilasos/users.json.
#KILASOS_TOKEN=

# Fallback alert webhook URL. The webhook config file at
# /var/lib/kilasos/webhook.json takes precedence when present.
#KILASOS_WEBHOOK=
